(footprint "Buzzer_P7.6mm" (version 20221018) (generator pcbnew) (layer "F.Cu")
    
    (descr "Generic Buzzer, D15mm height 7.5mm with RM7.6mm")
    (tags "buzzer")
    (property "Sheetfile" "standalone_example.kicad_sch")
    (property "Sheetname" "")
    (property "ki_description" "Buzzer, polarized")
    (property "ki_keywords" "quartz resonator ceramic")
    (attr through_hole)
    (fp_text reference "REF**" (at 4 -6.6) (layer "F.SilkS")
        (effects (font (size 1 1) (thickness 0.15)))
    )
    (fp_text value "Buzzer" (at 3.8 6) (layer "F.Fab")
        (effects (font (size 1 1) (thickness 0.15)))
    )
    (fp_text user "+" (at -0.01 -2.54) (layer "F.SilkS")
        (effects (font (size 1 1) (thickness 0.15)))
    )
    (fp_text user "+" (at -0.01 -2.54) (layer "F.Fab")
        (effects (font (size 1 1) (thickness 0.15)))
    )
    (fp_text user "${REFERENCE}" (at 3.8 -4) (layer "F.Fab")
        (effects (font (size 1 1) (thickness 0.15)))
    )
    (fp_circle (center 3.8 0) (end 8.9 0)
      (stroke (width 0.12) (type solid)) (fill none) (layer "F.SilkS"))
    (fp_circle (center 3.8 0) (end 9 0)
      (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
    (fp_circle (center 3.8 0) (end 4.8 0)
      (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
    (fp_circle (center 3.8 0) (end 8.9 0)
      (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
    (pad "1" thru_hole rect (at 0 0) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask") (pinfunction "-") (pintype "passive"))
    (pad "2" thru_hole circle (at 7.6 0) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask") (pinfunction "+") (pintype "passive"))
    (model "${KICAD6_3DMODEL_DIR}/Buzzer_Beeper.3dshapes/Buzzer_15x7.5RM7.6.wrl"
      (offset (xyz 0 0 0))
      (scale (xyz 1 1 1))
      (rotate (xyz 0 0 0))
    )
  )
